# Copy to .env for local development. Values match infra/compose.dev.yaml.
# Every variable is validated at startup; the api refuses to start if one is wrong.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Base URL users reach the site at. Links in emails are built from it.
PUBLIC_BASE_URL=http://localhost:5173

# Signs session cookies. At least 32 characters. Generate one for anything but local
# development: openssl rand -base64 32
AUTH_SECRET=local-development-only-secret-not-for-real-use

DATABASE_URL=postgres://osusume:osusume_dev@localhost:54329/osusume

# Directory for uploaded images. Must be writable by the api.
IMAGE_STORAGE_PATH=./.data/images

# SMTP. These defaults point at Mailpit. SMTP_USER and SMTP_PASSWORD are optional,
# but must be set together. With them the api requires TLS: SMTP_SECURE=false means
# STARTTLS, usually on port 587, and it refuses to log in to a server without it.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Osusume <no-reply@example.test>"
