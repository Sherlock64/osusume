{
  "name": "osusume",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @osusume/api dev",
    "dev:web": "pnpm --filter @osusume/web dev",
    "dev:services": "podman compose -f infra/compose.dev.yaml up -d",
    "dev:services:down": "podman compose -f infra/compose.dev.yaml down",
    "db:generate": "pnpm --filter @osusume/api db:generate",
    "db:migrate": "pnpm --filter @osusume/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
